# deps
node_modules/
web/node_modules/

# build output
dist/
web/dist/

# Docs build products (family gitignore block): an accidental in-tree Jekyll
# build taints nothing; CI resolves the bundle fresh.
docs/.bundle/
docs/vendor/
docs/_site/
docs/Gemfile.lock
docs/.jekyll-cache/
docs/.jekyll-metadata
docs/pagefind/
docs/pagefind*

# os / editor
.DS_Store
*.log
*.swp
.vscode/
.idea/
Thumbs.db

# npm
npm-debug.log*
*.tgz

# install/report noise (the family block; govstruct canon)
coverage/
.npm/

# Environment files never travel with the repo.
.env
.env.*
!.env.example
